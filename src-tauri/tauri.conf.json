{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UniSim",
  "version": "0.3.0",
  "identifier": "dev.unisim.desktop",
  "build": {
    "beforeDevCommand": "npx vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "UniSim",
        "width": 1440,
        "height": 900,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b0c0d",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Scientific physics simulation engine",
    "longDescription": "Keyboard-driven physics sandbox: 23 modules verified against closed-form results, multi-run comparison, sweeps and a live theater.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
